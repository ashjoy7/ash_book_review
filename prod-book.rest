# Get all books
GET https://ash-book-review.onrender.com/books HTTP/1.1

# Get a single book by ID
###
GET https://ash-book-review.onrender.com/books/{id} HTTP/1.1

# Create a new book
###
POST https://ash-book-review.onrender.com/books HTTP/1.1
Content-Type: application/json

{
  "title": "1984",
  "authorName": "George Orwell",
  "genre": "Dystopian",  
  "publishedYear": 1949,
  "summary": "A dystopian social science fiction novel and cautionary tale about the future.",
  "quote": "Big Brother is watching you.",
  "numReview": 0
}

# Update a book
###
PUT https://ash-book-review.onrender.com/books/{id} HTTP/1.1
Content-Type: application/json

{
  "title": "1984",
  "authorName": "George Orwell",
  "genre": "Dystopian", 
  "publishedYear": 1949,
  "summary": "An updated summary of the book.",
  "quote": "Big Brother is watching you.",
  "numReview": 5
}

# Delete a book
###
DELETE https://ash-book-review.onrender.com/books/{id} HTTP/1.1
