# Create a new review
POST https://ash-book-review.onrender.com/reviews HTTP/1.1
Content-Type: application/json

{
  "bookId": "64a0f06d0cfae412fe1e1b23",  // Replace with actual bookId
  "reviewerId": "64a0f06d0cfae412fe1e1b24",  // Replace with actual reviewerId
  "rating": 5,
  "comment": "A brilliant book with deep insights."
}

# Get all reviews
GET https://ash-book-review.onrender.com/reviews HTTP/1.1

# Get a review by ID
GET https://ash-book-review.onrender.com/reviews/{reviewId} HTTP/1.1

# Update a review
PUT https://ash-book-review.onrender.com/reviews/{reviewId} HTTP/1.1
Content-Type: application/json

{
  "bookId": "64a0f06d0cfae412fe1e1b23",  // Replace with actual bookId
  "reviewerId": "64a0f06d0cfae412fe1e1b24",  // Replace with actual reviewerId
  "rating": 4,
  "comment": "An insightful read with some flaws."
}

# Delete a review
DELETE https://ash-book-review.onrender.com/reviews/{reviewId} HTTP/1.1
