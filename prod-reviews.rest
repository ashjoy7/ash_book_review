# Create a new review for a book
POST https://ash-book-review.onrender.com/books/{bookId}/reviews HTTP/1.1
Content-Type: application/json

{
  "reviewerId": "1234567890",  // Replace with actual reviewerId
  "rating": 5,
  "reviewText": "I loved this book!",
  "createdAt": "2024-06-29T12:00:00Z",
  "updatedAt": "2024-06-29T12:00:00Z"
}

# Get all reviews for a book
GET https://ash-book-review.onrender.com/books/{bookId}/reviews HTTP/1.1

# Update a review for a book
PUT https://ash-book-review.onrender.com/books/{bookId}/reviews/{reviewId} HTTP/1.1
Content-Type: application/json

{
  "rating": 2,
  "reviewText": "I didn't like this book."
}

# Delete a review for a book
DELETE https://ash-book-review.onrender.com/books/{bookId}/reviews/{reviewId} HTTP/1.1
