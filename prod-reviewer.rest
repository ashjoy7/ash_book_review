# Create a new reviewer
POST https://ash-book-review.onrender.com/reviewers HTTP/1.1
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "reviews": []  // Initially an empty array or can be populated with reviewIds
}

# Get all reviewers
GET https://ash-book-review.onrender.com/reviewers HTTP/1.1

# Get a reviewer by ID
GET https://ash-book-review.onrender.com/reviewers/{reviewerId} HTTP/1.1

# Update a reviewer
PUT https://ash-book-review.onrender.com/reviewers/{reviewerId} HTTP/1.1
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@newemail.com",
  "reviews": ["64a0f06d0cfae412fe1e1b23"]  // Replace with actual reviewIds
}

# Delete a reviewer
DELETE https://ash-book-review.onrender.com/reviewers/{reviewerId} HTTP/1.1
